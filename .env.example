# Supabase Auth (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase server only. Never expose or commit this value.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Runtime: Supavisor transaction pooler on port 6543 for Vercel.
DATABASE_URL="postgresql://prisma.project-ref:password@region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"

# CLI migrations: Supavisor session pooler on port 5432.
DIRECT_URL="postgresql://prisma.project-ref:password@region.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

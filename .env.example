# Supabase Auth (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase server only. Never expose or commit this value.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Runtime: Supavisor transaction pooler on port 6543 for Vercel.
DATABASE_URL="postgresql://prisma.project-ref:password@region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"

# CLI migrations: Supavisor session pooler on port 5432.
DIRECT_URL="postgresql://prisma.project-ref:password@region.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Public legal requisites shown on /privacy and /terms. Required before public launch.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME="Full legal name of the data operator"
NEXT_PUBLIC_LEGAL_OPERATOR_EMAIL="privacy@example.com"
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS="Operator postal address"

# Optional support contacts shown in Profile.
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
NEXT_PUBLIC_DONATION_URL="https://example.com/support-mira"

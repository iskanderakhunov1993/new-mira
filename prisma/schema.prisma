generator client {
  provider     = "prisma-client"
  output       = "../apps/web/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                 String    @id @db.Uuid
  email              String?   @unique
  name               String?
  onboardingComplete Boolean   @default(false)
  onboardingStep     Int       @default(1)
  goal               String?
  lastPeriod         DateTime? @db.Date
  cycleLength        Int       @default(28)
  cyclePattern       String    @default("regular")
  periodLength       Int       @default(5)
  weightKg           Float?
  cycleForecasts     Boolean   @default(true)
  privateInsights    Boolean   @default(false)
  todayWidgets       String[]  @default(["water", "movement", "temperature", "weight", "plan"]) @map("today_widgets")
  todayHiddenWidgets String[]  @default([]) @map("today_hidden_widgets")
  todayHiddenDate    DateTime? @db.Date @map("today_hidden_date")
  healthDataConsent  Boolean   @default(false)
  privacyConsent     Boolean   @default(false)
  sensitiveConsent   Boolean   @default(false)
  firstPromptDismissed Boolean  @default(false)
  spotlightStatus    String    @default("pending")
  consentAcceptedAt  DateTime?
  consentVersion     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  entries            Entry[]
  productEvents      ProductEvent[]
  healthAssessments  HealthAssessment[]
  externalIdentities ExternalIdentity[]
  appSessions        AppSession[]
  accountLinkTokens  AccountLinkToken[]
  insightInteractions InsightInteraction[]

  @@map("profiles")
}

model InsightInteraction {
  id          String    @id @default(cuid())
  userId      String    @map("user_id") @db.Uuid
  profile     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightKey  String    @map("insight_key") @db.VarChar(200)
  readAt      DateTime? @map("read_at")
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, insightKey])
  @@index([userId, updatedAt])
  @@map("insight_interactions")
}

model AccountLinkToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  profileId String   @map("profile_id") @db.Uuid
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("account_link_tokens")
}

model ExternalIdentity {
  id          String   @id @default(cuid())
  provider    String
  subject     String
  profileId   String   @map("profile_id") @db.Uuid
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  displayName String?  @map("display_name")
  username    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([provider, subject])
  @@index([profileId])
  @@map("external_identities")
}

model AppSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  profileId  String   @map("profile_id") @db.Uuid
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  provider   String
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([profileId, expiresAt])
  @@index([expiresAt])
  @@map("app_sessions")
}

model HealthAssessment {
  id         String   @id @default(cuid())
  userId     String   @map("user_id") @db.Uuid
  profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  type       String
  answers    Json
  resultCode String   @map("result_code")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, date])
  @@index([userId, type])
  @@map("health_assessments")
}

model Entry {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id") @db.Uuid
  profile            Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime @db.Date
  period             String?
  periodClots        Boolean?
  periodLeak         Boolean?
  periodNightChange  Boolean?
  periodHourlyChange Boolean?
  periodStarted      Boolean  @default(false)
  periodEnded        Boolean  @default(false)
  pain               Int?
  painLocations      String[]
  painTypes          String[]
  painImpact         String?
  mood               String?
  energy             String?
  symptoms           String[]
  symptomIntensity   Json?
  medicationIntakes  Json?    @map("medication_intakes")
  activityTypes      String[]  @default([])
  contraceptionMethod String?
  contraceptionStatus String?
  pregnancyTest      String?
  ovulationTest      String?
  sexualActivity     String?
  sexualComfort      String?
  sleepHours         Float?
  waterMl            Int?
  weightKg           Float?
  basalTemperature   Float?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("entries")
}

model ProductEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.Uuid
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  route     String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("product_events")
}

model PublicProductEvent {
  id        String   @id @default(cuid())
  name      String
  route     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@map("public_product_events")
}

generator client {
  provider     = "prisma-client"
  output       = "../apps/web/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                 String    @id @db.Uuid
  email              String    @unique
  name               String?
  onboardingComplete Boolean   @default(false)
  goal               String?
  lastPeriod         DateTime? @db.Date
  cycleLength        Int       @default(28)
  periodLength       Int       @default(5)
  weightKg           Float?
  cycleForecasts     Boolean   @default(true)
  privateInsights    Boolean   @default(false)
  healthDataConsent  Boolean   @default(false)
  privacyConsent     Boolean   @default(false)
  sensitiveConsent   Boolean   @default(false)
  consentAcceptedAt  DateTime?
  consentVersion     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  entries            Entry[]

  @@map("profiles")
}

model Entry {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id") @db.Uuid
  profile            Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime @db.Date
  period             String?
  periodClots        Boolean?
  periodLeak         Boolean?
  periodNightChange  Boolean?
  periodHourlyChange Boolean?
  pain               Int?
  painLocations      String[]
  painTypes          String[]
  painImpact         String?
  mood               String?
  symptoms           String[]
  symptomIntensity   Json?
  sleepHours         Float?
  waterMl            Int?
  weightKg           Float?
  basalTemperature   Float?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("entries")
}
